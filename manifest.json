{
  "manifest_version": 3,
  "name": "Course Mapper Highlighter",
  "version": "1.0",
  "description": "Underline VCCS courses and show mappings to VT, UVA, GMU.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "commands": {
    "toggle-highlighting": {
      "suggested_key": {
        "default": "Alt+`"
      },
      "description": "Toggle highlighting on/off"
    }
  }
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["equivalency.csv"],
      "matches": ["<all_urls>"]
    }
  ]
}
